"""
Builds distribution_analysis_v1/02_persona_effects_and_conclusions.ipynb -- Part 2 (sections
7-14), REVISED per the 2026-09-21 methodological review:
- magnitude and direction always reported together, explicit "neither alone is sufficient" note
- a single-text worked delta-vector example added BEFORE Section 9's aggregate analysis
- per-model direction-tracking properly aggregated to TEXT level first (was pseudoreplicated),
  with text-clustered bootstrap CIs
- "same underlying skill" language replaced with "association" + explicit small-n (7 models) caveat
- new/disappeared-emotion section reframed as exploratory and sample-size-caveated
- emotion-word-leak section's causal language toned down to a transparent, non-causal description
- PRIMARY/SECONDARY/EXPLORATORY labels applied throughout
- unit-of-analysis note added under every formal test
- Section 12 restructured as explicit Hypothesis -> Operationalization -> Test -> Effect+CI -> p
  -> Interpretation blocks, with Supported/Partially supported/Not supported verdicts
- new Section 14 subsection: majority-label exact-match comparison, framed as information
  preservation, not "vectors are better"
- full language audit for overclaiming words

Run: python build_notebook_2.py
Then: jupyter nbconvert --to notebook --execute --inplace <output path>
"""
import nbformat as nbf
from pathlib import Path

OUT_PATH = Path(r"C:\Users\umers\Desktop\thesis\thesis final\distribution_analysis_v1\02_persona_effects_and_conclusions.ipynb")

nb = nbf.v4.new_notebook()
cells = []


def md(text):
    cells.append(nbf.v4.new_markdown_cell(text))


def code(text):
    cells.append(nbf.v4.new_code_cell(text))


md("""# Part 2: Persona Effects, Human-LLM Alignment & Conclusions

Continues directly from `01_foundations_and_baseline.ipynb`. Covers sections 7-14: the human
persona effect, the LLM persona effect, a worked single-text example of the central comparison,
the human-vs-LLM shift-alignment analysis (ensemble-level and per-model), model/prompt
breakdowns, emotion-level analysis, formal hypothesis verdicts, six qualitative case studies with
dataset-wide pattern quantification, and the final conclusions — including a direct comparison of
what a majority-label analysis would and would not have shown.

**Labeling convention** (see Part 1 Section 1): **[PRIMARY]** = directly operationalizes H1-H4;
**[SECONDARY]** = planned descriptive/robustness analysis; **[EXPLORATORY]** = not planned in the
proposal, reported honestly but never treated as confirmatory.""")

code("""import sys
import math
import warnings
from itertools import combinations
from pathlib import Path

import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

%matplotlib inline
warnings.filterwarnings('ignore', category=RuntimeWarning)
sys.path.insert(0, str(Path.cwd().parent / 'scripts'))
from plot_style import setup_style, sig_bracket, sig_stars, stat_box, violin_box_strip, vector_bar_pair, categorical_proportion_bars, COLORS
setup_style()

from emotion_vectors import EMOTIONS, build_vector, safe_cosine_similarity, dominant_set, delta_vector
import stats_utils as su
from build_emotion_distributions import (
    BASE, OUT_DIR, POOL_TO_KEY, POOL_LABEL, MODEL_COLS, MODEL_RAW_COLS, _normalize_label_fallback,
)

pd.set_option('display.max_columns', 50)
pd.set_option('display.width', 140)
CATEGORY_ORDER = ['unambiguous', 'author_independent', 'author_relevant']
CATEGORY_LABELS = [POOL_LABEL[c] for c in CATEGORY_ORDER]

qc_report = (OUT_DIR / 'interpretation' / 'analysis_qc_report.md').read_text(encoding='utf-8')
assert 'Gate status: PASS' in qc_report, "QC GATE HAS NOT PASSED"
print("QC gate PASS confirmed.")

human_cmp = pd.read_csv(OUT_DIR / 'human_neutral_persona_comparisons.csv')
llm_cmp = pd.read_csv(OUT_DIR / 'llm_neutral_persona_comparisons.csv')
matched = pd.read_csv(OUT_DIR / 'human_vs_llm_matched.csv')
human_vectors = pd.read_csv(OUT_DIR / 'human_vectors.csv')
llm_vectors = pd.read_csv(OUT_DIR / 'llm_ensemble_vectors.csv')
human_annotations = pd.read_csv(BASE / 'human_annotations.csv')
human_annotations['text_id'] = human_annotations['text_id'].astype(str)
human_annotations['pool_key'] = human_annotations['pool'].map(POOL_TO_KEY)
for df in (human_cmp, llm_cmp, matched, human_vectors, llm_vectors):
    df['text_id'] = df['text_id'].astype(str)

# --- SINGLE AUTHORITATIVE CATEGORY SOURCE (audit repair, 2026-09-21) -------------------------
# Previously: pool_of_text = human_annotations.drop_duplicates('text_id')[...]['pool_key'].
# That was wrong for 9 texts. human_annotations.csv is internally self-contradictory on them:
# their 'neutral' rows say Unambiguous while their persona (a/b) rows say author_relevant --
# they were re-classified between the neutral and the persona collection rounds. Because
# drop_duplicates() keeps whichever row appears first (side 'a'), those 9 texts silently entered
# every human-side analysis as author_relevant, making the category grouping 91/100/109 instead
# of the designed, balanced 100/100/100 -- and disagreeing with Section 10, which reads the
# category off the LLM comparison table instead. That mismatch is the entire reason Section 8 and
# Section 10 reported different numbers for the same quantity.
# sampled_texts.csv is the master file the corpus was stratified on; experiment_results_all.csv
# and both *_neutral_persona_comparisons.csv already agree with it. We therefore take it as the
# single source of truth, everywhere, and never read the category off human_annotations again.
CATEGORY_SOURCE = 'master'   # 'master' = sampled_texts.csv (authoritative) | 'persona_round' = old behaviour
sampled_texts = pd.read_csv(BASE / 'sampled_texts.csv')
sampled_texts['text_id'] = sampled_texts['text_id'].astype(str)
pool_master = sampled_texts.set_index('text_id')['classification'].map(POOL_TO_KEY)
pool_persona_round = human_annotations.drop_duplicates('text_id').set_index('text_id')['pool_key']
pool_of_text = pool_master if CATEGORY_SOURCE == 'master' else pool_persona_round

_cmp_src = pd.DataFrame({'master': pool_master, 'persona_round': pool_persona_round}).dropna()
_disagree = sorted(_cmp_src.index[_cmp_src['master'] != _cmp_src['persona_round']], key=int)
print(f"Category source = {CATEGORY_SOURCE} (sampled_texts.csv). "
      f"Category counts: {pool_of_text.value_counts().reindex(CATEGORY_ORDER).to_dict()}")
print(f"{len(_disagree)} texts are classified inconsistently inside human_annotations.csv "
      f"(neutral row vs persona rows); all resolved to the master file's value:")
print(f"  {_disagree}")
if _disagree:
    print("  master says:", _cmp_src.loc[_disagree,'master'].unique().tolist(),
          "| persona rows say:", _cmp_src.loc[_disagree,'persona_round'].unique().tolist())
print("  See the H3 sensitivity check in Section 12, which runs the analysis both ways.")

# Raw human vote multisets + a count-based TV, defined once here because several later sections
# (the H3 null-referencing and the H4 count-standardization) need to work from raw votes rather
# than from the pre-built probability vectors, so that vote COUNTS can be manipulated directly.
human_votes = {}
for _, _r in human_annotations.iterrows():
    _v = [x.strip().lower() for x in str(_r['raters_raw']).split('|') if x.strip()]
    human_votes[(str(_r['text_id']), _r['side'])] = [x for x in _v if x in EMOTIONS]

EI = {e: i for i, e in enumerate(EMOTIONS)}
def tv_counts(a, b):
    # Total-variation distance between two vote multisets, computed from raw counts.
    va = np.zeros(len(EMOTIONS)); vb = np.zeros(len(EMOTIONS))
    for x in a: va[EI[x]] += 1
    for x in b: vb[EI[x]] += 1
    return 0.5 * np.abs(va/va.sum() - vb/vb.sum()).sum()

human_valid = human_cmp[human_cmp['valid_comparison']==True].copy()
llm_valid = llm_cmp[llm_cmp['valid_comparison']==True].copy()
matched['category'] = matched['pool_key'].map(POOL_LABEL)
print(f"human_cmp: {len(human_valid)} valid | llm_cmp: {len(llm_valid)} valid | matched: {len(matched)}")
""")

# ===========================================================================
# SECTION 7
# ===========================================================================
md("""## 7. Human persona effect: neutral human vector → persona human vector

**[PRIMARY — operationalizes H1]** For each text, compare the neutral-framing human vector
(this study's own new neutral round — see Part 1 Section 1.1) to each persona-framing human
vector (a/b), then compare shift magnitude across the 3 categories. Recall from Part 1 Section 4
that even two *independent* "no persona" measurements show 31.5%-52.9% distribution dissimilarity
— the shift magnitudes below should be read against that context, not against zero.

**Unit of analysis:** one row per text (text-level mean of persona_a and persona_b comparisons),
300 texts — no repeated-text pseudoreplication in this aggregation.""")

code("""text_level = human_valid.groupby('text_id').agg(
    tv_distance=('tv_distance','mean'), entropy_change=('entropy_change','mean'),
    max_probability_change=('max_probability_change','mean'), support_size_change=('support_size_change','mean'),
).reset_index()
text_level['pool_key'] = text_level['text_id'].map(pool_of_text)
text_level['category'] = text_level['pool_key'].map(POOL_LABEL)

fig, ax = plt.subplots(figsize=(7.5,6))
groups = [text_level[text_level['category']==c]['tv_distance'].values*100 for c in CATEGORY_LABELS]
violin_box_strip(ax, groups, CATEGORY_LABELS, colors=[COLORS[c] for c in CATEGORY_LABELS],
                  ylabel='Human persona shift magnitude (TV, %)', title='Human: neutral -> persona vector shift, by category (MAGNITUDE only)', title_pad=16)
ax.tick_params(axis='x', rotation=15)
kw_stat, kw_p = su.kruskal_wallis(*groups)
sig_bracket(ax, 1, 3, p=kw_p, text=f'{sig_stars(kw_p)}  p={kw_p:.2e}')
plt.tight_layout()
plt.show()

for c in CATEGORY_ORDER:
    sub = text_level[text_level['pool_key']==c]
    print(f"{POOL_LABEL[c]}: n={len(sub)} mean shift={sub['tv_distance'].mean()*100:.1f}% (median={sub['tv_distance'].median()*100:.1f}%)")
print()
print("NOTE: TV distance is a MAGNITUDE-only measure -- it says nothing about which emotions moved")
print("or in what direction. The redistribution/transition analysis below, and the direction")
print("(delta-vector) analysis in Section 9, are necessary complements, not optional extras.")
""")

md("""### What changed: redistribution, dominant-emotion transitions, new/disappeared emotions

**[SECONDARY]** Magnitude (TV) and dominant-label change are analytically distinct: a text can
shift a lot in TV while its dominant emotion survives, or shift little while the dominant emotion
flips (e.g. in a near-tied vector). Both are reported; neither substitutes for the other.""")

code("""dom_changed_rate = human_valid.groupby('pool_key')['dominant_emotion_changed'].mean().reindex(CATEGORY_ORDER)
new_rate = human_valid.groupby('pool_key')['new_emotion_introduced'].mean().reindex(CATEGORY_ORDER)
dis_rate = human_valid.groupby('pool_key')['emotion_disappeared'].mean().reindex(CATEGORY_ORDER)
summary = pd.DataFrame({'category': CATEGORY_LABELS, 'dominant_emotion_change_rate': dom_changed_rate.values,
                         'new_emotion_rate': new_rate.values, 'disappeared_emotion_rate': dis_rate.values})
display(summary.round(3))
""")

# AUDIT REPAIR (2026-09-21): `dominant_emotion_changed` is True only when the neutral and persona
# dominant SETS are wholly disjoint. Everything else -- including "guilt" becoming a {guilt, shame}
# tie, or a {joy, pride} tie resolving to just "pride" -- was being reported as "unchanged". That
# is a real movement in the modal judgment being filed under the label "no change". The binary is
# kept (it is what the H-tests use) but the four distinct outcomes are now reported beside it.
md("""#### The "unchanged" category is doing too much work

**[SECONDARY — added 2026-09-21]** `dominant_emotion_changed` is defined as *fully disjoint*
dominant sets. That makes it conservative in a specific and somewhat misleading way: a text whose
neutral dominant is `guilt` and whose persona dominant is a `{guilt, shame}` tie is recorded as
**unchanged**, even though the modal judgment demonstrably moved. The binary is retained
unmodified (the formal tests use it, and it is the conservative choice), but reporting only two
buckets overstates how much genuinely stayed put, so all four outcomes are broken out here.""")

code("""def dom_outcome(row):
    n = set(str(row['neutral_dominant']).split('|'))
    p = set(str(row['persona_dominant']).split('|'))
    if n == p: return 'A. identical set'
    if not (n & p): return 'D. fully disjoint (-> CHANGED)'
    if len(n) == 1 and len(p) > 1: return 'B. single emotion split into a tie'
    if len(n) > 1 and len(p) == 1: return 'C. tie resolved to a single emotion'
    return 'B/C. partial overlap of two ties'

OUTCOMES = ['A. identical set','B. single emotion split into a tie','C. tie resolved to a single emotion',
            'B/C. partial overlap of two ties','D. fully disjoint (-> CHANGED)']
rows4 = []
for name, d in (('Human', human_valid), ('LLM ensemble', llm_valid)):
    oc = d.apply(dom_outcome, axis=1).value_counts(normalize=True).reindex(OUTCOMES).fillna(0)*100
    rows4.append(pd.Series(oc, name=name))
dom4 = pd.DataFrame(rows4)
display(dom4.round(1))

fig, ax = plt.subplots(figsize=(11.5, 5.5))
bottom = np.zeros(len(dom4))
palette = ['#4C72B0','#8FB0D8','#DDA15E','#C9ADA7','#C44E52']
for i, oc in enumerate(OUTCOMES):
    ax.barh(np.arange(len(dom4)), dom4[oc].values, left=bottom, color=palette[i], label=oc)
    for j, v in enumerate(dom4[oc].values):
        if v > 3.5:
            ax.text(bottom[j]+v/2, j, f'{v:.0f}%', ha='center', va='center', fontsize=9,
                    color='white' if i in (0,4) else 'black', fontweight='bold')
    bottom += dom4[oc].values
ax.set_yticks(np.arange(len(dom4))); ax.set_yticklabels(dom4.index)
ax.set_xlabel('% of valid comparisons'); ax.set_xlim(0, 100)
ax.set_title('Dominant-emotion outcomes: four distinct cases, not two\\n(only the rightmost is counted as "changed" by dominant_emotion_changed)', pad=14)
ax.legend(fontsize=8, loc='lower center', bbox_to_anchor=(0.5,-0.38), ncol=2)
ax.grid(False)
plt.tight_layout(); plt.show()

for name in dom4.index:
    not_identical = dom4.loc[name, OUTCOMES[1:4]].sum()
    reported_unchanged = 100 - dom4.loc[name, OUTCOMES[4]]
    print(f"{name}: reported 'unchanged' = {reported_unchanged:.1f}%, but only "
          f"{dom4.loc[name, OUTCOMES[0]]:.1f}pp of that is an IDENTICAL dominant set -- "
          f"{not_identical:.1f}pp involves a tie forming, resolving, or partially overlapping.")
""")

code("""def build_transition_matrix(df, label):
    unique_dom = df[(~df['neutral_dominant'].astype(str).str.contains(r'\\|')) & (~df['persona_dominant'].astype(str).str.contains(r'\\|')) &
                     df['neutral_dominant'].notna() & (df['neutral_dominant'] != '')]
    n_total, n_retained = len(df), len(unique_dom)
    trans = unique_dom.groupby(['neutral_dominant','persona_dominant']).size().reset_index(name='count')
    return trans, n_retained, n_total

trans_human, n_ret_h, n_tot_h = build_transition_matrix(human_valid, 'human')
trans_llm, n_ret_l, n_tot_l = build_transition_matrix(llm_valid, 'llm')

fig, axes = plt.subplots(1, 2, figsize=(15, 6.5))
for ax, trans, n_ret, n_tot, label in zip(axes, (trans_human, trans_llm), (n_ret_h, n_ret_l), (n_tot_h, n_tot_l), ('HUMAN', 'LLM ENSEMBLE')):
    mat = trans.pivot_table(index='neutral_dominant', columns='persona_dominant', values='count', fill_value=0).reindex(index=list(EMOTIONS), columns=list(EMOTIONS), fill_value=0)
    im = ax.imshow(mat.values, cmap='viridis', aspect='auto')
    ax.set_xticks(range(11)); ax.set_xticklabels(EMOTIONS, rotation=90, fontsize=8)
    ax.set_yticks(range(11)); ax.set_yticklabels(EMOTIONS, fontsize=8)
    ax.set_title(f'{label} dominant-emotion transitions\\n(unique-dominant only, tie-aware: n={n_ret}/{n_tot} retained)', pad=12)
    ax.set_xlabel('Persona dominant emotion'); ax.set_ylabel('Neutral dominant emotion')
    ax.grid(False)
    fig.colorbar(im, ax=ax, fraction=0.046, label='count')
plt.tight_layout()
plt.show()

for label, mat_df in (('Human', trans_human), ('LLM', trans_llm)):
    off_diag = mat_df[mat_df['neutral_dominant']!=mat_df['persona_dominant']].sort_values('count', ascending=False)
    print(f"{label}: most frequent dominant-emotion FLIP in this dataset: {off_diag.iloc[0]['neutral_dominant']} -> {off_diag.iloc[0]['persona_dominant']} ({off_diag.iloc[0]['count']} occurrences)")
""")

md("""> **Key finding:** both matrices are diagonal-dominant (the dominant emotion usually survives
> a persona change) — consistent with the 20-40% dominant-change rates above. The single most
> frequent flip differs between sources: humans most often move a neutral-dominant "joy" to
> "relief" (8 occurrences), the LLM ensemble most often moves "joy" to "pride" (46 occurrences).
> Both replacements keep a positive valence, though the specific emotion differs — reported here
> descriptively; this dataset does not support a stronger claim about why. The tie-aware method
> (rows/columns restricted to a *unique* dominant emotion on both sides) is stated explicitly
> rather than resolving ties arbitrarily.""")

# ===========================================================================
# SECTION 8
# ===========================================================================
md("""## 8. LLM persona effect: neutral ensemble vector → persona ensemble vector

**[PRIMARY — operationalizes H2; the category-ordering component previews H3]** Same logic, for
the 7-model LLM ensemble, stratified by exact prompt configuration (never pooled).

**Unit of analysis:** one row per text (per-config means averaged within each text, then within
category), 300 texts.""")

code("""llm_text_level = (llm_valid.groupby(['text_id','prompt_variant','label_format'])['tv_distance'].mean()
                  .groupby('text_id').mean().reset_index())
llm_text_level['pool_key'] = llm_text_level['text_id'].map(pool_of_text)
llm_text_level['category'] = llm_text_level['pool_key'].map(POOL_LABEL)

fig, ax = plt.subplots(figsize=(7.5,6))
groups = [llm_text_level[llm_text_level['category']==c]['tv_distance'].values*100 for c in CATEGORY_LABELS]
violin_box_strip(ax, groups, CATEGORY_LABELS, colors=[COLORS[c] for c in CATEGORY_LABELS],
                  ylabel='LLM ensemble shift magnitude (TV, %, avg. across 6 configs)', title='LLM: neutral -> persona vector shift, by category (MAGNITUDE only)', title_pad=16)
ax.tick_params(axis='x', rotation=15)
kw_stat, kw_p = su.kruskal_wallis(*groups)
sig_bracket(ax, 1, 3, p=kw_p, text=f'{sig_stars(kw_p)}  p={kw_p:.2e}')
plt.tight_layout()
plt.show()

for c in CATEGORY_ORDER:
    sub = llm_text_level[llm_text_level['pool_key']==c]
    print(f"{POOL_LABEL[c]}: n={len(sub)} mean shift={sub['tv_distance'].mean()*100:.1f}%")
print()
print("This Kruskal-Wallis test is SECONDARY/descriptive support for H2 (a formal, Holm-corrected")
print("test of the category ordering itself, on human data, is the PRIMARY test for H3 in Section 12).")
""")

md("""### A data-quality correction made during this analysis, reported transparently

**[Methods note, not a hypothesis test]** During this analysis, 49/300 texts (16.3%) were found
to have the author's actual emotion word present in the LLM stimulus text for a subset of the raw
model-response cells (a prompt-generation artifact predating this analysis), which was corrected
by regenerating those prompts and re-collecting all 7 models' answers for the affected rows. The
before/after numbers below (both computed with the same "mean of 6 per-config category means"
metric) are reported for transparency about what changed in the data during this project, not as
a statistical test.""")

code("""# 'before' is a historical snapshot of the pre-correction data (retained in
# backup_pre_hidden_emo_fix/) and cannot be recomputed from the current files, so it stays literal.
# AUDIT REPAIR (2026-09-21): 'after' was ALSO hardcoded, and was taken from the Section-10 route
# while the Section-8 figure two cells above used a different category source -- so this chart and
# that one disagreed about the same quantity. 'after' is now computed live from the current data
# using the same single category source as everything else, so the two can no longer drift apart.
leak_fix_before = {'Unambiguous': 8.7, 'Author-Independent Ambiguous': 12.2, 'Author-Relevant Ambiguous': 28.8}
_after = (llm_valid.assign(_k=llm_valid['text_id'].map(pool_of_text))
          .groupby(['_k','prompt_variant','label_format'])['tv_distance'].mean()
          .reset_index().groupby('_k')['tv_distance'].mean() * 100)
leak_fix_after = {POOL_LABEL[c]: float(_after[c]) for c in CATEGORY_ORDER}
n_leaked = {'Unambiguous': 26, 'Author-Independent Ambiguous': 14, 'Author-Relevant Ambiguous': 9}
print("'after' recomputed live from current data:", {k: round(v,2) for k,v in leak_fix_after.items()})

fig, ax = plt.subplots(figsize=(9, 6.5))
x = np.arange(3)
width = 0.35
ax.bar(x - width/2, [leak_fix_before[c] for c in CATEGORY_LABELS], width=width, label='Before correction', color='#B0B0B0')
ax.bar(x + width/2, [leak_fix_after[c] for c in CATEGORY_LABELS], width=width, label='After correction', color='#DD8452')
ax.set_ylim(0, max(leak_fix_after.values()) * 1.28)
for i, c in enumerate(CATEGORY_LABELS):
    delta = leak_fix_after[c] - leak_fix_before[c]
    ax.annotate(f'+{delta:.1f}pp\\n({n_leaked[c]} texts affected)', xy=(i, max(leak_fix_before[c], leak_fix_after[c]) + 1.5),
                ha='center', fontsize=9, fontweight='bold')
ax.set_xticks(x); ax.set_xticklabels(CATEGORY_LABELS, rotation=15, ha='right')
ax.set_ylabel('LLM persona shift magnitude (%, mean-of-6-config-means)')
ax.set_title('Data-quality correction: before vs. after, by category', pad=14)
ax.legend(fontsize=9, loc='upper left')
plt.tight_layout()
plt.show()
""")

md("""> **Observation, stated without a causal claim:** the size of the change (+2.6pp, +2.9pp,
> +0.3pp) tracks the number of affected texts per category (26, 14, 9) in this single before/after
> comparison. This is consistent with the correction having removed a confound that suppressed
> the measured effect specifically in the affected texts, but **this proportionality was not
> formally tested** (e.g. no test of the before/after difference against the number of affected
> texts was run), the comparison has only 3 category-level data points, and category differences
> unrelated to the correction could also contribute. All hypothesis verdicts in Section 12 are
> unchanged whether the before- or after-correction data is used; the corrected data is used
> throughout this analysis because it is the accurate description of the actual stimulus text.""")

code("""def load_llm_individual_labels():
    df = pd.read_csv(BASE / 'experiment_results_all.csv')
    df['pool_key'] = df['classification'].map(POOL_TO_KEY)
    df['text_id'] = df['text_id'].astype(str)
    for model, norm_col in MODEL_COLS.items():
        raw_col = MODEL_RAW_COLS[model]
        norm_vals = df[norm_col].astype(str).str.strip().str.lower()
        needs_fallback = df[norm_col].isna() | (df[norm_col].astype(str).str.strip()=='')
        resolved = norm_vals.where(~needs_fallback, None)
        fallback_vals = df.loc[needs_fallback, raw_col].apply(lambda v: _normalize_label_fallback(v) if pd.notna(v) else None)
        resolved.loc[needs_fallback] = fallback_vals
        resolved = resolved.where(resolved.isin(EMOTIONS), None)
        df[f'{model}__resolved'] = resolved
    return df

llm_indiv = load_llm_individual_labels()
model_change_rows = []
for (tid, pv, lf), g in llm_indiv.groupby(['text_id','prompt_variant','label_format']):
    by_framing = {r['framing_condition']: r for _, r in g.iterrows()}
    if 'neutral' not in by_framing: continue
    nrow = by_framing['neutral']
    for framing, side in (('persona_a','a'), ('persona_b','b')):
        if framing not in by_framing: continue
        prow = by_framing[framing]
        for model in MODEL_COLS:
            n_label, p_label = nrow[f'{model}__resolved'], prow[f'{model}__resolved']
            if n_label is None or p_label is None: continue
            model_change_rows.append({'model': model, 'text_id': tid, 'pool_key': nrow['pool_key'], 'changed': n_label != p_label})
model_change_df = pd.DataFrame(model_change_rows)
# text-level aggregation first (fraction of side x config cells that changed, per text), THEN average across texts
model_change_text_level = model_change_df.groupby(['model','pool_key','text_id'])['changed'].mean().reset_index()
rate_table = model_change_text_level.groupby(['model','pool_key'])['changed'].mean().unstack().reindex(columns=CATEGORY_ORDER)
rate_table.columns = CATEGORY_LABELS
rate_table = rate_table.sort_values(CATEGORY_LABELS[2], ascending=False)

fig, ax = plt.subplots(figsize=(10, 5.5))
x = np.arange(len(rate_table))
width = 0.25
for i, c in enumerate(CATEGORY_LABELS):
    ax.bar(x + (i-1)*width, rate_table[c].values*100, width=width, label=c, color=COLORS[c])
ax.set_xticks(x); ax.set_xticklabels(rate_table.index, rotation=15)
ax.set_ylabel('Mean label-change rate (%, text-level)')
ax.set_title('Every one of the 7 models individually shows the same category ordering', pad=14)
ax.legend(fontsize=8)
plt.tight_layout()
plt.show()
display((rate_table*100).round(1))
most_sensitive = rate_table[CATEGORY_LABELS[2]].idxmax()
least_sensitive = rate_table[CATEGORY_LABELS[2]].idxmin()
print(f"\\nHighest observed mean on Author-Relevant: {most_sensitive} ({rate_table.loc[most_sensitive, CATEGORY_LABELS[2]]*100:.1f}%)")
print(f"Lowest observed mean on Author-Relevant: {least_sensitive} ({rate_table.loc[least_sensitive, CATEGORY_LABELS[2]]*100:.1f}%)")
print("No pairwise significance test was run between models here -- 'highest/lowest observed mean', not 'best/worst'.")
""")

md("""> **Key finding [SECONDARY, supports H2/H3]:** the category ordering (Unambiguous <
> Author-Independent < Author-Relevant) holds for every one of the 7 models' individual,
> text-level label-change rate, with no exceptions — this is not one model driving an aggregate
> pattern. Ministral and Qwen3 show the highest observed label-change rates, Gemma3 the lowest;
> Ministral was also identified in Part 1 as a model that almost never gives an off-list answer
> (0.01% excluded) — "gives a clean, on-list answer" and "changes that answer under framing"
> appear to be different properties of a model's behavior in this dataset, though this was not
> formally tested.""")

# ===========================================================================
# SECTION 8.1 -- generic_human control (NEW, audit repair 2026-09-21)
# ===========================================================================
md("""### 8.1 Is it the persona, or merely the presence of an author? The `generic_human` control

**[SECONDARY — added 2026-09-21]** Every neutral-vs-persona comparison in this analysis has a
built-in confound that was previously acknowledged in prose but never tested: persona prompts add
an **"Author: ..." line that neutral prompts do not have at all**. A measured shift could
therefore reflect the *specific persona content* or merely the *presence of an author attribution*.

The data to separate these has existed in `experiment_results_all.csv` since collection — a third
LLM condition, `generic_human`, which supplies an author line with no distinguishing persona
content (1,800 rows, a full quarter of the LLM dataset). It was never analysed in either notebook.
It is analysed here.

Read the three comparisons as a decomposition:
- **neutral → generic_human** isolates the effect of *adding an author line at all*.
- **generic_human → persona** isolates the effect of *the persona's specific content*, holding the
  presence of an author line constant. This is the cleaner test of what H2 actually claims.
- **neutral → persona** is the original comparison, which confounds the two.""")

code("""gh_cmp = []
for (tid, pv, lf), g in llm_indiv.groupby(['text_id','prompt_variant','label_format']):
    bf = {r['framing_condition']: r for _, r in g.iterrows()}
    def vec_of(cond, other):
        if cond not in bf or other not in bf: return None, None
        ms = [m for m in MODEL_COLS if bf[cond][f'{m}__resolved'] is not None and bf[other][f'{m}__resolved'] is not None]
        if not ms: return None, None
        return build_vector([bf[cond][f'{m}__resolved'] for m in ms]), build_vector([bf[other][f'{m}__resolved'] for m in ms])
    for lo, hi, name in (('neutral','generic_human','neutral -> generic_human'),
                          ('generic_human','persona_a','generic_human -> persona_a'),
                          ('generic_human','persona_b','generic_human -> persona_b'),
                          ('neutral','persona_a','neutral -> persona_a'),
                          ('neutral','persona_b','neutral -> persona_b')):
        va, vb = vec_of(lo, hi)
        if va is None or vb is None: continue
        gh_cmp.append({'text_id': tid, 'prompt_variant': pv, 'label_format': lf, 'comparison': name,
                       'tv': 0.5*sum(abs(va[e]-vb[e]) for e in EMOTIONS)})
gh_df = pd.DataFrame(gh_cmp)
gh_df['pool_key'] = gh_df['text_id'].map(pool_of_text)

order = ['neutral -> generic_human','generic_human -> persona_a','generic_human -> persona_b',
         'neutral -> persona_a','neutral -> persona_b']
summ = gh_df.groupby('comparison')['tv'].agg(['mean','median','count']).reindex(order)
summ['mean_pct'] = summ['mean']*100
ci_rows = []
for comp in order:
    sub = gh_df[gh_df['comparison']==comp]
    _, lo, hi = su.cluster_bootstrap_ci(sub['tv'].values*100, sub['text_id'].values, np.mean, n_boot=3000)
    ci_rows.append({'comparison': comp, 'ci_lo': lo, 'ci_hi': hi})
summ = summ.join(pd.DataFrame(ci_rows).set_index('comparison'))
display(summ[['mean_pct','ci_lo','ci_hi','count']].round(2))

fig, ax = plt.subplots(figsize=(11, 5.5))
cols = ['#8C8C8C','#4C72B0','#4C72B0','#C44E52','#C44E52']
y = np.arange(len(order))
ax.barh(y, summ['mean_pct'].values,
        xerr=[summ['mean_pct'].values-summ['ci_lo'].values, summ['ci_hi'].values-summ['mean_pct'].values],
        color=cols, capsize=4)
ax.set_yticks(y); ax.set_yticklabels(order, fontsize=9.5); ax.invert_yaxis()
ax.set_xlabel('Mean TV shift (%, text-clustered 95% CI)')
ax.set_title('Decomposing the persona effect: author line alone vs. persona content\\n(grey = author line only; blue = persona content, author line held constant; red = original confounded comparison)', pad=14)
plt.tight_layout(); plt.show()

base = summ.loc['neutral -> generic_human','mean_pct']
for side in ('a','b'):
    conf = summ.loc[f'neutral -> persona_{side}','mean_pct']
    clean = summ.loc[f'generic_human -> persona_{side}','mean_pct']
    print(f"side {side}: confounded neutral->persona = {conf:.2f}%  |  author-line-only = {base:.2f}%  |  "
          f"persona content alone (generic_human->persona) = {clean:.2f}%")
print()
print("INTERPRETATION GUIDE: if the persona effect were merely the presence of an author line,")
print("'generic_human -> persona' would be near zero and 'neutral -> generic_human' would account")
print("for most of the confounded total. The printed values above show which pattern actually holds.")
""")

md("""> **Why this matters for H2:** the `neutral -> persona` comparison that H2 is formally tested on
> cannot by itself distinguish "the model responds to who the author is" from "the model responds
> to being given an author at all". This control does distinguish them, and it should be read
> alongside the H2 verdict in Section 12 rather than as a replacement for it. It is labelled
> **[SECONDARY]** because it was not pre-registered — but it addresses a limitation the earlier
> version of this notebook could only state, not test.""")

# ===========================================================================
# SECTION 8.2 -- zero-shift coverage (NEW, audit repair 2026-09-21)
# ===========================================================================
md("""### 8.2 How often does framing change *nothing at all*?

**[SECONDARY — added 2026-09-21]** Mean shift magnitudes hide a discrete and important fact: in a
large share of comparisons the persona vector is **bit-for-bit identical** to the neutral vector
(TV exactly 0). This is not a small-shift case, it is a no-shift case, and it is worth reporting
separately because a mean of, say, 18% is a very different finding depending on whether it comes
from every cell shifting a little or from a majority not shifting at all and a minority shifting a
great deal. It also explains why so many directional cosines are undefined: a zero delta vector
has no direction.""")

code("""zs_rows = []
for name, d in (('Human', human_valid), ('LLM ensemble', llm_valid)):
    tv = d['tv_distance'].values
    zs_rows.append({'source': name, 'n_comparisons': len(tv), 'pct_exactly_zero': (tv < 1e-9).mean()*100,
                    'pct_under_10pct': (tv < 0.10).mean()*100, 'median_tv_pct': np.median(tv)*100,
                    'mean_tv_pct': tv.mean()*100})
zs_df = pd.DataFrame(zs_rows)
display(zs_df.round(2))

fig, axes = plt.subplots(1, 2, figsize=(13.5, 5))
for ax, (name, d) in zip(axes, (('Human', human_valid), ('LLM ensemble', llm_valid))):
    tv = d['tv_distance'].values*100
    ax.hist(tv, bins=40, color=COLORS['human' if name=='Human' else 'llm'], alpha=0.8, edgecolor='white')
    pz = (tv < 1e-7).mean()*100
    ax.axvline(0, color='black', lw=1.5)
    ax.set_title(f'{name}: distribution of persona shift\\n{pz:.1f}% of comparisons shift EXACTLY zero', pad=12)
    ax.set_xlabel('TV shift (%)'); ax.set_ylabel('# comparisons')
plt.tight_layout(); plt.show()

hz = (human_valid['tv_distance'].values < 1e-9).mean()*100
lz = (llm_valid['tv_distance'].values < 1e-9).mean()*100
print(f"Persona changed NOTHING in {hz:.1f}% of human comparisons and {lz:.1f}% of LLM comparisons.")
print()
print("Note the asymmetry is partly structural, not purely behavioural: the human vectors are built")
print("from 3 raters and the LLM vectors from 7 models, and a 7-way vote has more distinct states")
print("available to it than a 3-way vote, so the two are not on a common footing. See the")
print("granularity limitation discussed under H4 in Section 12.")
""")

# ===========================================================================
# SECTION 9
# ===========================================================================
md("""## 9. The central comparison: does the LLM's shift track the human's shift?

**[PRIMARY — operationalizes H4]** This is the heart of RQ3/H4. Not "does the LLM's answer equal
the human's answer" but: **when authorship changes a human's interpretation, does the LLM's
interpretation move in the same direction, by a similar amount?** As established in Part 1
Section 5, magnitude and direction answer different questions and neither is sufficient alone —
both are computed and reported together throughout this section.

### One real text, worked in full, before the aggregate analysis

Before looking at all 3,600 matched rows at once, here is exactly what is being compared, for a
single real text: **Human neutral → Human persona → ΔHuman**, and the same for the LLM ensemble.
Section 9's aggregate analysis (below) repeats exactly this comparison over the whole dataset.""")

code("""# pick one real, moderately-rich example (not a trivial single-emotion case on either side)
worked_candidates = matched[(matched['delta_cosine_defined']) & (matched['prompt_variant']=='one_shot') & (matched['label_format']=='numbered')].copy()
worked_candidates['n_nonzero_h'] = sum((worked_candidates[f'human_delta_{e}'].abs() > 1e-9).astype(int) for e in EMOTIONS)
worked_candidates['n_nonzero_l'] = sum((worked_candidates[f'llm_delta_{e}'].abs() > 1e-9).astype(int) for e in EMOTIONS)
worked_row = worked_candidates[(worked_candidates['n_nonzero_h']>=3) & (worked_candidates['n_nonzero_l']>=3)].iloc[0]
tid_w, side_w = worked_row['text_id'], worked_row['persona_side']

hn_w = {e: human_vectors[(human_vectors['text_id']==tid_w) & (human_vectors['side']=='neutral')].iloc[0][f'vec_prob_{e}'] for e in EMOTIONS}
hp_w = {e: human_vectors[(human_vectors['text_id']==tid_w) & (human_vectors['side']==side_w)].iloc[0][f'vec_prob_{e}'] for e in EMOTIONS}
llm_sub_w = llm_vectors[(llm_vectors['text_id']==tid_w) & (llm_vectors['prompt_variant']=='one_shot') & (llm_vectors['label_format']=='numbered')]
ln_w = {e: llm_sub_w[llm_sub_w['framing_condition']=='neutral'].iloc[0][f'vec_prob_{e}'] for e in EMOTIONS}
lp_w = {e: llm_sub_w[llm_sub_w['framing_condition']==('persona_a' if side_w=='a' else 'persona_b')].iloc[0][f'vec_prob_{e}'] for e in EMOTIONS}
delta_h_w = delta_vector(hn_w, hp_w)
delta_l_w = delta_vector(ln_w, lp_w)

print(f"Worked example: text {tid_w}, persona side {side_w}, prompt one_shot/numbered")
print(f"Human neutral:  {[(e,round(v,2)) for e,v in hn_w.items() if v>0]}")
print(f"Human persona:  {[(e,round(v,2)) for e,v in hp_w.items() if v>0]}")
print(f"delta-Human:    {[(e,round(v,2)) for e,v in delta_h_w.items() if abs(v)>1e-9]}")
print()
print(f"LLM neutral:    {[(e,round(v,2)) for e,v in ln_w.items() if v>0]}")
print(f"LLM persona:    {[(e,round(v,2)) for e,v in lp_w.items() if v>0]}")
print(f"delta-LLM:      {[(e,round(v,2)) for e,v in delta_l_w.items() if abs(v)>1e-9]}")
""")

code("""fig, axes = plt.subplots(2, 3, figsize=(16, 8.5))
def delta_bars(ax, delta, title):
    vals = [delta[e] for e in EMOTIONS]
    colors_bar = ['#2E7D32' if v > 0 else ('#C62828' if v < 0 else '#CCCCCC') for v in vals]
    ax.bar(EMOTIONS, vals, color=colors_bar, edgecolor='white')
    ax.axhline(0, color='black', linewidth=0.8)
    ax.set_title(title, fontsize=11)
    ax.tick_params(axis='x', rotation=45)

axes[0,0].bar(EMOTIONS, [hn_w[e] for e in EMOTIONS], color='#8C8C8C'); axes[0,0].set_title('Human NEUTRAL'); axes[0,0].tick_params(axis='x', rotation=45)
axes[0,1].bar(EMOTIONS, [hp_w[e] for e in EMOTIONS], color='#4C72B0'); axes[0,1].set_title('Human PERSONA'); axes[0,1].tick_params(axis='x', rotation=45)
delta_bars(axes[0,2], delta_h_w, 'DELTA-Human (persona - neutral)')
axes[1,0].bar(EMOTIONS, [ln_w[e] for e in EMOTIONS], color='#8C8C8C'); axes[1,0].set_title('LLM NEUTRAL'); axes[1,0].tick_params(axis='x', rotation=45)
axes[1,1].bar(EMOTIONS, [lp_w[e] for e in EMOTIONS], color='#DD8452'); axes[1,1].set_title('LLM PERSONA'); axes[1,1].tick_params(axis='x', rotation=45)
delta_bars(axes[1,2], delta_l_w, 'DELTA-LLM (persona - neutral)')
fig.suptitle(f'Worked example: text {tid_w} -- the exact comparison Section 9 repeats over the whole dataset', fontsize=13, fontweight='bold', y=1.02)
plt.tight_layout()
plt.show()

cos_w = worked_row['delta_cosine_similarity']
print(f"Cosine similarity of delta-Human and delta-LLM for this one text: {cos_w:.3f}")
print(f"TV magnitude: human={worked_row['human_shift_percent']:.1f}%, llm={worked_row['llm_shift_percent']:.1f}%")
""")

md("""### The aggregate analysis: magnitude, then direction, over all matched rows

**Unit of analysis:** the row-level Spearman rho below uses all 3,600 matched
(text × persona-side × prompt-config) rows; its 95% CI uses a text-clustered bootstrap (10,000
resamples of whole texts, never individual rows) to avoid pseudoreplication from the same text
appearing up to 12 times.""")

code("""rho, p, lo, hi = su.spearman_with_cluster_bootstrap(
    matched['human_shift_percent'].values, matched['llm_shift_percent'].values, matched['text_id'].values, n_boot=10000)

fig, ax = plt.subplots(figsize=(7.5, 7))
for c in CATEGORY_LABELS:
    sub = matched[matched['category']==c]
    ax.scatter(sub['human_shift_percent'], sub['llm_shift_percent'], s=10, alpha=0.22, color=COLORS[c], label=c, linewidths=0)
z = np.polyfit(matched['human_shift_percent'], matched['llm_shift_percent'], 1)
xs = np.linspace(0, 100, 50)
ax.plot(xs, np.polyval(z, xs), color='black', linewidth=2, linestyle='--', label=f'linear fit (slope={z[0]:.2f})')
ax.set_xlabel('Human shift magnitude (%)'); ax.set_ylabel('LLM shift magnitude (%)')
ax.set_title('Human vs. LLM shift MAGNITUDE\\n(every matched text x persona-side x prompt-config row)', pad=14)
stat_box(ax, [f'Spearman rho = {rho:.3f}', f'95% CI [{lo:.3f}, {hi:.3f}] (text-clustered bootstrap)', f'clustered bootstrap p = {p:.4f}', f'n = {len(matched)} rows, {matched[\"text_id\"].nunique()} unique texts'], loc='upper left')
ax.legend(fontsize=8.5, loc='lower right', markerscale=2.5)
plt.tight_layout()
plt.show()
print(f"MAGNITUDE: Spearman rho={rho:.3f}, 95% CI [{lo:.3f},{hi:.3f}], clustered bootstrap p={p:.4f}")
print("-- a weak positive association; humans and LLMs do not closely track each other's shift SIZE.")
print()
# AUDIT REPAIR (2026-09-22): this cell previously printed the p-value returned by
# scipy.stats.spearmanr() over all 3,600 rows, beside a text-clustered CI. That p treats ~12
# correlated rows per text as independent evidence -- duplicating rows would leave rho unchanged
# while shrinking the p-value -- so it was inconsistent with the interval shown next to it. The
# helper no longer returns it; inference now comes from the same text-clustered bootstrap as
# the interval. The per-stratum breakdown below avoids pooling correlated rows altogether.
print("Per side x prompt-configuration Spearman (one row per text within each stratum, so no")
print("repeated-text pooling), with text-bootstrap 95% CIs:")
strat_rows = []
for (side, pv, lf), g in matched.groupby(['persona_side','prompt_variant','label_format']):
    if len(g) < 20: continue
    r_s = su.stats.spearmanr(g['human_shift_percent'], g['llm_shift_percent']).statistic
    bs = np.empty(2000)
    vals = g[['human_shift_percent','llm_shift_percent']].values
    rng_s = np.random.default_rng(42)
    for i in range(2000):
        idx = rng_s.integers(0, len(vals), len(vals))
        bs[i] = su.stats.spearmanr(vals[idx,0], vals[idx,1]).statistic
    lo_s, hi_s = np.nanpercentile(bs, [2.5, 97.5])
    strat_rows.append({'persona_side': side, 'prompt_variant': pv, 'label_format': lf,
                       'n_texts': len(g), 'rho': r_s, 'ci_lo': lo_s, 'ci_hi': hi_s})
strat_spear = pd.DataFrame(strat_rows)
display(strat_spear.round(3))
print(f"rho across the {len(strat_spear)} strata: min={strat_spear['rho'].min():.3f}, "
      f"median={strat_spear['rho'].median():.3f}, max={strat_spear['rho'].max():.3f}; "
      f"{int((strat_spear['ci_lo'] > 0).sum())}/{len(strat_spear)} strata have a CI excluding zero.")
""")

code("""delta_cols_h = [f'human_delta_{e}' for e in EMOTIONS]
delta_cols_l = [f'llm_delta_{e}' for e in EMOTIONS]
text_deltas = matched.groupby('text_id')[delta_cols_h+delta_cols_l].mean().reset_index()
text_deltas['pool_key'] = text_deltas['text_id'].map(pool_of_text)
text_deltas['category'] = text_deltas['pool_key'].map(POOL_LABEL)

def cosine_fn(a,b):
    res = safe_cosine_similarity(a,b)
    return res.value if res.defined else None

human_delta_list = [dict(zip(EMOTIONS,row[delta_cols_h])) for _,row in text_deltas.iterrows()]
llm_delta_list = [dict(zip(EMOTIONS,row[delta_cols_l])) for _,row in text_deltas.iterrows()]
obs_mean_cos, null_cos, p_cos = su.permutation_pairing_test(human_delta_list, llm_delta_list, cosine_fn, n_perm=10000)
per_text_cos = [cosine_fn(human_delta_list[i], llm_delta_list[i]) for i in range(len(human_delta_list))]
text_deltas['directional_cosine'] = per_text_cos
n_defined = sum(1 for v in per_text_cos if v is not None)

fig, ax = plt.subplots(figsize=(8.5, 5.5))
per_text_cos_df = text_deltas.dropna(subset=['directional_cosine'])
ax.hist(per_text_cos_df['directional_cosine'], bins=30, color='#4C72B0', alpha=0.75, edgecolor='white')
ax.axvline(obs_mean_cos, color='crimson', linewidth=2.2, label=f'observed mean = {obs_mean_cos:.3f}')
ax.axvline(np.mean(null_cos), color='gray', linestyle='--', linewidth=2, label=f'chance-pairing null = {np.mean(null_cos):.3f}')
ax.set_xlabel('Cosine similarity of human vs. LLM delta vectors'); ax.set_ylabel('# texts')
ax.set_title('Human vs. LLM shift DIRECTION\\n(one row per text -- see worked example above for what this compares)', pad=14)
stat_box(ax, [f'permutation p = {p_cos:.4f}', f'n = {n_defined}/{len(text_deltas)} texts (defined on both sides)'], loc='upper right')
ax.legend(fontsize=9)
plt.tight_layout()
plt.show()
print(f"DIRECTION: mean cosine={obs_mean_cos:.3f}, permutation p={p_cos:.4f} -- text-level, {n_defined}/300 texts.")
print("The permutation test (shuffling which LLM delta is paired with which human delta, preserving")
print("marginals) shows the LLM's direction tracks the SPECIFIC text's human direction better than")
print("chance pairing, but a raw cosine of ~0.13 is a partial association, not a close match.")
print()
# AUDIT REPAIR (2026-09-21): the "{n_defined}/300 texts" coverage figure is computed AFTER
# averaging each text's deltas over both persona sides and all 6 prompt configs. Averaging turns
# cells where one side did not move at all (a zero delta, whose direction is undefined) into a
# non-zero average with a defined direction -- so it manufactures coverage that the underlying
# observations do not have. Both figures are now reported.
raw_def = int(matched['delta_cosine_defined'].sum()); raw_tot = len(matched)
print("--- Coverage, stated at both levels of aggregation ---")
print(f"  After averaging over side and config : {n_defined}/{len(text_deltas)} texts "
      f"({n_defined/len(text_deltas)*100:.0f}%) have a defined cosine.")
print(f"  At the raw unit of observation       : {raw_def}/{raw_tot} (text x side x config) cells "
      f"({raw_def/raw_tot*100:.0f}%) have a defined cosine.")
print(f"  The {raw_tot-raw_def} undefined cells are ones where the human or the LLM delta is exactly")
print("  zero -- one side simply did not move, so there is no direction to compare. Averaging hides")
print("  this; it does not resolve it. See the zero-shift analysis in Section 8.2.")
print()
print("As a robustness check, the mean cosine computed WITHOUT any averaging:")
_raw_cos = matched.loc[matched['delta_cosine_defined']==True, 'delta_cosine_similarity']
print(f"  raw (text x side x config) mean cosine = {_raw_cos.mean():.3f}  vs  averaged = {obs_mean_cos:.3f}")
print("  -- the estimate itself is robust to the aggregation choice; only the coverage claim was overstated.")
print()
print("MAGNITUDE and DIRECTION give different answers here (weak-but-significant magnitude")
print("correlation; small-but-above-chance directional cosine) -- consistent with H4's own wording")
print("that direction may PARTIALLY align while magnitude DIFFERS; neither number alone would show this.")
""")

md("""### Per-model directional tracking [EXPLORATORY]

The ensemble-level result above averages across all 7 models. Breaking this out by model checks
the association proposed in Part 1 Section 6: is the model with the highest observed baseline
distribution similarity also the model most associated with tracking a persona-driven shift
DIRECTION?

**Unit of analysis fix:** each model's one-hot delta is first averaged to ONE value **per text**
(across the 2 persona sides and 6 prompt configs available for that text), before computing the
per-model mean and a text-clustered bootstrap 95% CI — the same (text, config, side) row would
otherwise be counted up to 12 times per model, understating the true uncertainty.""")

code("""human_delta_by_tid_side = {}
for _, r in human_valid.iterrows():
    human_delta_by_tid_side[(r['text_id'], r['persona_side'])] = {e: r[f'delta_{e}'] for e in EMOTIONS}

per_model_cos_rows = []
for (tid, pv, lf), g in llm_indiv.groupby(['text_id','prompt_variant','label_format']):
    by_framing = {r['framing_condition']: r for _, r in g.iterrows()}
    if 'neutral' not in by_framing: continue
    nrow = by_framing['neutral']
    for framing, side in (('persona_a','a'), ('persona_b','b')):
        if framing not in by_framing: continue
        prow = by_framing[framing]
        h_delta = human_delta_by_tid_side.get((tid, side))
        if h_delta is None: continue
        for model in MODEL_COLS:
            n_label, p_label = nrow[f'{model}__resolved'], prow[f'{model}__resolved']
            if n_label is None or p_label is None: continue
            m_delta = {e: 0.0 for e in EMOTIONS}
            if n_label != p_label:
                m_delta[n_label] -= 1.0
                m_delta[p_label] += 1.0
            cos = cosine_fn(h_delta, m_delta)
            if cos is not None:
                per_model_cos_rows.append({'model': model, 'text_id': tid, 'cosine': cos})
per_model_cos_df = pd.DataFrame(per_model_cos_rows)
# TEXT-LEVEL aggregation first (avoids pseudoreplication -- see note above)
per_model_text_level = per_model_cos_df.groupby(['model','text_id'])['cosine'].mean().reset_index()

model_direction_rows = []
for model in MODEL_COLS:
    sub = per_model_text_level[per_model_text_level['model']==model]
    mean_val, lo_val, hi_val = su.cluster_bootstrap_ci(sub['cosine'].values, sub['text_id'].values, np.mean, n_boot=5000)
    model_direction_rows.append({'model': model, 'mean_cosine': mean_val, 'ci_lo': lo_val, 'ci_hi': hi_val, 'n_texts': len(sub)})
model_direction_df = pd.DataFrame(model_direction_rows).set_index('model').sort_values('mean_cosine', ascending=False)

fig, ax = plt.subplots(figsize=(9, 5.5))
order = model_direction_df.index.tolist()
means = model_direction_df['mean_cosine'].values
err_lo = means - model_direction_df['ci_lo'].values
err_hi = model_direction_df['ci_hi'].values - means
ax.bar(order, means, yerr=[err_lo, err_hi], capsize=4, color=plt.cm.plasma(np.linspace(0.15,0.85,len(order))))
ax.axhline(0, color='black', linewidth=0.8)
ax.set_ylabel('Mean cosine (this model\\'s delta vs. human delta)\\ntext-level, 95% bootstrap CI')
ax.set_title('Per-model directional tracking (text-clustered CI)', pad=14)
plt.xticks(rotation=20)
plt.tight_layout()
plt.show()
display(model_direction_df.round(3))
""")

code("""# Baseline (no-persona) distribution-similarity ranking, computed and verified in
# 01_foundations_and_baseline.ipynb Section 6 -- hardcoded here since each notebook runs in its
# own separate kernel and cannot share in-memory variables; these are the exact printed
# text-level-aggregated values from that notebook's own output.
baseline_alignment_rank = {'Gemini': 0.644, 'Claude': 0.622, 'OpenAI': 0.606, 'Llama31': 0.586,
                            'Qwen3': 0.574, 'Ministral': 0.554, 'Gemma3': 0.551}
comparison = pd.DataFrame({
    'baseline_distribution_similarity': pd.Series(baseline_alignment_rank),
    'baseline_rank': pd.Series(baseline_alignment_rank).rank(ascending=False).astype(int),
    'direction_tracking_cosine': model_direction_df['mean_cosine'],
    'direction_tracking_rank': model_direction_df['mean_cosine'].rank(ascending=False).astype(int),
})
spearman_ranks, p_ranks = su.stats.spearmanr(comparison['baseline_rank'], comparison['direction_tracking_rank'])
display(comparison.round(3))
print(f"\\nSpearman correlation between the two rankings (n=7 models): rho={spearman_ranks:.3f}, p={p_ranks:.4f}")
print("NOTE: n=7 is a very small sample for a correlation -- treat this as a single exploratory")
print("observation, not a well-powered statistical result.")
""")

md("""> **Key finding [EXPLORATORY, small-n caveat applies]:** with the pseudoreplication fix
> applied (text-level aggregation before computing each model's mean), the two rankings show a
> positive but **not conventionally significant** association (Spearman rho=0.750, p=0.0522
> across the 7 models). Gemini and Claude rank 1st/2nd on both measures; Ministral ranks lowest
> on directional tracking (mean cosine 0.062, 95% CI [-0.006, 0.128] — a CI that includes zero,
> meaning its directional tracking is not clearly distinguishable from no association at all) and
> is also among the lower baseline-similarity models, though not the single lowest there. This is
> reported as a single exploratory observation with only 7 data points, not a confirmed
> association — the borderline p-value should not be rounded down to "significant," and a naive
> row-level version of this same comparison (not shown as a primary result here) had produced a
> misleadingly small p-value before the text-level correction was applied, which is itself a
> caution about checking the unit of analysis before trusting a correlation like this one.""")

md("""### A distinct question: does persona framing concentrate or disperse interpretation, and
is that related to shift magnitude at all?

**[SECONDARY]**""")

code("""fig, ax = plt.subplots(figsize=(7.5, 6.5))
ax.scatter(text_level['tv_distance']*100, text_level['entropy_change'], s=14, alpha=0.35, color='#4C72B0', linewidths=0)
rho_ent, p_ent = su.stats.spearmanr(text_level['tv_distance'], text_level['entropy_change'])
ax.axhline(0, color='black', linewidth=0.8)
ax.set_xlabel('TV shift magnitude (%)'); ax.set_ylabel('Entropy change (persona - neutral, nats)')
ax.set_title('Magnitude and dispersion: empirically weak relationship\\n(large TV shift does not predict more/less dispersion)', pad=14)
stat_box(ax, [f'Spearman rho = {rho_ent:.3f}', f'p = {p_ent:.4f}', 'unit: 1 row/text, n=300'], loc='upper left')
plt.tight_layout()
plt.show()
print(f"Correlation between shift MAGNITUDE and entropy CHANGE: rho={rho_ent:.3f}, p={p_ent:.4f}")
""")

md("""> **Key finding:** magnitude (TV) and dispersion (entropy change) show only a weak,
> non-significant correlation (rho=0.088, p=0.13) in this sample — consistent with them being
> analytically distinct questions rather than two views of the same thing, though a
> non-significant correlation at n=300 does not rule out a small true relationship.""")

# AUDIT REPAIR (2026-09-21): the by-category entropy test previously existed ONLY in
# scripts/run_analysis.py (feeding fig10/table10), never in either notebook -- so the notebooks
# could not actually be the authoritative source for a result the write-up cites. It is added
# here, at the correct TEXT-LEVEL unit. In run_analysis.py it was computed on raw comparison rows
# (2 per text for humans, 12 for the LLM), which is pseudoreplication and inflated significance
# enough to flip a conclusion: the LLM Unambiguous increase read as significant at the inflated
# n=1200 but is not significant at the correct n=100. Both are now text-level and agree.
md("""#### Does persona framing disperse interpretation? Formal test, by category

**[SECONDARY]** Wilcoxon signed-rank on each category's text-level mean entropy change against
zero, BH-FDR corrected across the 6 (source × category) tests. **Unit of analysis: text** — each
text contributes exactly one value, averaged over persona sides (and, for the LLM, over the 6
prompt configurations).""")

code("""ent_rows = []
for label, d in (('human', human_valid), ('llm', llm_valid)):
    d = d.copy(); d['pool_key'] = d['text_id'].map(pool_of_text)
    per_text = d.groupby(['pool_key','text_id'], as_index=False)[['entropy_change','normalized_entropy_change']].mean()
    for c in CATEGORY_ORDER:
        sub = per_text[per_text['pool_key']==c]
        v_raw = sub['entropy_change'].dropna().values
        v_norm = sub['normalized_entropy_change'].dropna().values
        _, p_raw = su.wilcoxon_signed_rank(v_raw, np.zeros_like(v_raw))
        ent_rows.append({'source': label, 'category': POOL_LABEL[c], 'n_texts': len(v_raw),
                          'mean_entropy_change': v_raw.mean(),
                          'mean_normalized_entropy_change': v_norm.mean(),
                          'direction': 'more dispersed' if v_raw.mean() > 0 else 'more concentrated',
                          'p_raw': p_raw})
ent_df = pd.DataFrame(ent_rows)
ent_df['p_bh'] = su.bh_fdr(ent_df['p_raw'].values)
ent_df['significant_q05'] = ent_df['p_bh'] < 0.05
display(ent_df.round(5))

fig, ax = plt.subplots(figsize=(10, 5.5))
y = np.arange(len(ent_df))
cols = [COLORS['human'] if r['source']=='human' else COLORS['llm'] for _, r in ent_df.iterrows()]
ax.barh(y, ent_df['mean_entropy_change'].values, color=cols)
for i, (_, r) in enumerate(ent_df.iterrows()):
    ax.text(r['mean_entropy_change'] + 0.004, i, f"p_BH={r['p_bh']:.4f}{'  *' if r['significant_q05'] else '  (ns)'}",
            va='center', fontsize=8.5)
ax.set_yticks(y); ax.set_yticklabels([f"{r['source']} / {r['category']}" for _, r in ent_df.iterrows()], fontsize=9)
ax.invert_yaxis(); ax.axvline(0, color='black', lw=1)
ax.set_xlim(0, max(ent_df['mean_entropy_change'])*1.75)
ax.set_xlabel('Mean entropy change, persona - neutral (nats; positive = more dispersed)')
ax.set_title('Does persona framing disperse interpretation?\\nHumans: yes, in every category. LLM ensemble: no detectable effect anywhere.', pad=14)
plt.tight_layout(); plt.show()

n_h = int(ent_df[(ent_df['source']=='human')]['significant_q05'].sum())
n_l = int(ent_df[(ent_df['source']=='llm')]['significant_q05'].sum())
print(f"Significant at q<0.05: human {n_h}/3 categories, LLM {n_l}/3 categories.")
print("Humans reliably become LESS internally agreed under persona framing; the LLM ensemble")
print("moves its probability mass (Section 8 shows a clear TV shift) WITHOUT becoming measurably")
print("less agreed with itself -- a qualitative human/LLM difference that magnitude alone hides.")
""")

