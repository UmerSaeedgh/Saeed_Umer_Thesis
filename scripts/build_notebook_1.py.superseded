print(f"  LLM ensemble (7 models):                  {len(llm_vectors)} rows (= 300 texts x 4 framings x 3 variants x 2 formats)")
""")

md("""### Sanity checks: missing texts, duplicates, annotation counts, valid emotions, category
counts, persona coverage""")

code("""checks = []

def check(name, cond, detail=''):
    checks.append((name, bool(cond), detail))
    print(f"[{'PASS' if cond else 'FAIL'}] {name}" + (f' -- {detail}' if detail else ''))

missing_original = set(sample_text_ids) - set(original_vectors['text_id'])
check('all 300 texts have an original 5-reader vector', len(missing_original)==0, f'{len(missing_original)} missing')
missing_human = set(sample_text_ids) - set(human_vectors['text_id'])
check('all 300 texts have new human vectors', len(missing_human)==0, f'{len(missing_human)} missing')
missing_llm = set(sample_text_ids) - set(llm_vectors['text_id'].astype(str))
check('all 300 texts have LLM ensemble vectors', len(missing_llm)==0, f'{len(missing_llm)} missing')
check('no duplicate (text_id, side) in new human vectors', human_vectors.duplicated(subset=['text_id','side']).sum()==0)
check('no duplicate (text_id, framing, prompt_variant, label_format) in llm_vectors',
      llm_vectors.duplicated(subset=['text_id','framing_condition','prompt_variant','label_format']).sum()==0)
check('new human vectors: 900 rows (300 texts x 3 sides)', len(human_vectors)==900, f'got {len(human_vectors)}')
check('llm_vectors: 7200 rows (300 texts x 4 framings x 3 variants x 2 formats)', len(llm_vectors)==7200, f'got {len(llm_vectors)}')
check('human raters_raw: 0 blank', (human_annotations['raters_raw'].isna() | (human_annotations['raters_raw'].astype(str).str.strip()=='')).sum()==0)
zero_n_human = (human_vectors['vec_n']==0).sum()
zero_n_llm = (llm_vectors['vec_n']==0).sum()
zero_n_orig = (original_vectors['vec_n']==0).sum()
check('new human vectors: 0 rows with zero valid votes', zero_n_human==0, f'{zero_n_human} rows')
check('llm_vectors: 0 rows with zero valid votes (all 7 models off-list)', zero_n_llm==0, f'{zero_n_llm} rows')
check('original corpus vectors: 0 rows with zero valid votes', zero_n_orig==0, f'{zero_n_orig} rows')
check('3 categories all present, totaling 300', pool_counts.sum()==300 and len(pool_counts)==3)
check("new human vectors side counts == {'a':300,'b':300,'neutral':300}",
      human_vectors['side'].value_counts().to_dict() == {'a':300,'b':300,'neutral':300})

n_fail = sum(1 for _,ok,_ in checks if not ok)
print(f"\\n{len(checks)-n_fail}/{len(checks)} checks passed." + (f" {n_fail} FAILED." if n_fail else " All clear."))
""")

