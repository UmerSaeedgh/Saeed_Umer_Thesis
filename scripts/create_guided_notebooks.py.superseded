"""Canonical source for the NEW guided notebooks only.

This deliberately does not overwrite the earlier notebooks or their retired builders.
After editing this file or guided_analysis.py, regenerate and execute both notebooks.
"""
from pathlib import Path
import nbformat as nb

ROOT=Path(__file__).resolve().parents[1]
OUT=ROOT/'distribution_analysis_v1'

def md(s):return nb.v4.new_markdown_cell(s.strip())
def code(s):return nb.v4.new_code_cell(s.strip())
def write(name,cells):
    doc=nb.v4.new_notebook(cells=cells,metadata={'kernelspec':{'display_name':'Python 3','language':'python','name':'python3'},'language_info':{'name':'python','version':'3'}})
    nb.validate(doc);nb.write(doc,OUT/name)

