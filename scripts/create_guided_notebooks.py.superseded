axes[1].bar(CAT_NAMES,reference.excess,color='#177e89');axes[1].tick_params(axis='x',rotation=15);axes[1].axhline(0,color='grey');axes[1].set_ylabel('Observed minus expected (pp)');axes[1].set_title('Reference-adjusted distance is a different quantity')
