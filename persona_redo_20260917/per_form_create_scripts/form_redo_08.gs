function createForm() {
  var b64 = "";
  var jsonStr = Utilities.newBlob(Utilities.base64Decode(b64)).getDataAsString();
  var items = JSON.parse(jsonStr);

  var form = FormApp.create("Emotion Rating Study (Persona) - Redo - Form 08");
  form.setDescription(
    "Thank you for taking part in this short study.\n\n" +
    "You will read " + items.length + " short first-person passages, each written from the point of view of a specific author. " +
    "For each one, choose the ONE emotion its author most likely felt when writing it.\n\n" +
    "This takes about " + Math.ceil(items.length / 3) + " minutes. Your responses are completely anonymous."
  );
  form.setCollectEmail(false);

  var emotions = ["Anger", "Disgust", "Fear", "Guilt", "Joy", "Pride", "Relief", "Sadness", "Shame", "Surprise", "Trust"];
  for (var i = 0; i < items.length; i++) {
    var it = items[i];
    var title = "Text: " + it.text + "\nAuthor: " + it.persona;
    form.addMultipleChoiceItem()
      .setTitle(title)
      .setChoiceValues(emotions)
      .setRequired(true);
  }

  var editUrl = form.getEditUrl();
  var publishedUrl = form.getPublishedUrl();
  var formId = form.getId();

  var resultsSheet = SpreadsheetApp.openById("11ZEkJc06EcrEhuHtb0RgXja78dNHZEggH9TJ9aFVLJY").getSheets()[0];
  resultsSheet.appendRow(["form_redo_08", formId, editUrl, publishedUrl, items.length]);

  Logger.log("form_redo_08 created: " + formId + " || edit=" + editUrl + " || published=" + publishedUrl);
}
